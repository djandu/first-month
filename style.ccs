@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;500&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:'Poppins',sans-serif;
background:linear-gradient(180deg,#1d2748,#090d18);
color:white;
overflow:hidden;
height:100vh;
}

/* ========================= */
/* PAGE */
/* ========================= */

.page{
position:absolute;
inset:0;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
padding:25px;
text-align:center;
z-index:1;
}

.hidden{
display:none !important;
}

/* ========================= */
/* STARS */
/* ========================= */

.stars{
position:fixed;
inset:0;
pointer-events:none;
}

.stars::before{
content:"";
position:absolute;
inset:0;
background-image:
radial-gradient(white 1px,transparent 1px),
radial-gradient(white 1px,transparent 1px);
background-size:80px 80px;
opacity:.45;
}

/* ========================= */
/* TEXT */
/* ========================= */

h1{
font-family:"Playfair Display",serif;
font-size:34px;
margin-bottom:15px;
}

p{
line-height:1.7;
}

button{
margin-top:25px;
padding:14px 30px;
border:none;
border-radius:999px;
background:white;
cursor:pointer;
font-size:15px;
}

/* ========================= */
/* GAME */
/* ========================= */

.score{
font-size:26px;
margin:20px;
}

#loveArea{
position:absolute;
inset:0;
overflow:hidden;
}

#basket{
position:absolute;
bottom:90px;
left:50%;
transform:translateX(-50%);
font-size:70px;
z-index:10;
will-change:left;
}

.falling-love{
position:absolute;
top:-80px;
width:65px;
height:65px;
animation:fall 5s linear;
}

.falling-love img{
width:100%;
height:100%;
object-fit:contain;
}

@keyframes fall{

from{
transform:translateY(0);
}

to{
transform:translateY(110vh);
}

}

/* ========================= */
/* LETTER */
/* ========================= */

.paper{
    width:94%;
    max-width:760px;
    padding:18px;
}

#letter{

justify-content:flex-start;
padding-top:40px;
overflow-y:auto;
}

#letterText{

white-space:pre-wrap;
text-align:justify;
text-justify:inter-word;
line-height:1.9;
font-size:16px;
word-break:normal;

}

/* ========================= */
/* LITTLE LETTERS */
/* ========================= */

.mini-letter{

width:80px;
height:80px;

display:flex;
justify-content:center;
align-items:center;

font-size:40px;

cursor:pointer;

}

/* ========================= */
/* POPUP */
/* ========================= */

#popup{

position:fixed;
inset:0;

display:flex;
justify-content:center;
align-items:center;

background:rgba(0,0,0,.45);

z-index:999;

}

.popup-card{

width:85%;
max-width:340px;

background:white;
color:black;

padding:25px;

border-radius:18px;

}

#popupText{

margin:20px 0;
line-height:1.7;

}

/* ========================= */
/* MEMORY */
/* ========================= */

.rope{

width:360px;
display:grid;
grid-template-columns:repeat(3,100px);
justify-content:center;
gap:20px;
margin:45px auto;
padding-top:25px;

border-top:5px solid #c9a46c;
border-radius:50%;

}

.slot{

position:relative;
width:100px;
height:125px;

overflow:hidden;

border:none;

border-radius:12px;

display:flex;
justify-content:center;
align-items:center;

transition:.25s;

}

.slot img{

width:100%;
height:100%;

object-fit:cover;

border-radius:8px;

}

/* ========================= */
/* PHOTO BOX */
/* ========================= */

.photo-box{

margin-top:35px;

display:grid;

grid-template-columns:repeat(3,85px);

gap:15px;

}

.photo{

width:90px;
background:white;
padding:8px 8px 20px;
border-radius:3px;
box-shadow:0 8px 18px rgba(0,0,0,.35);
cursor:grab;
transition:.25s;

}

.photo img{
    width:100%;
    height:90px;
    object-fit:cover;
    pointer-events:none;
}

.photo:active{

transform:scale(.95);

}

#finishMemory{

margin-top:35px;

animation:fade .6s;

}

@keyframes fade{

from{

opacity:0;
transform:translateY(20px);

}

to{

opacity:1;
transform:translateY(0);

}

}

.slot:hover{

border-color:white;

transform:scale(1.03);

}

.slot img{

pointer-events:none;

}

.slot::before{

content:"";
position:absolute;
top:-18px;
width:14px;
height:30px;
background:#bfbfbf;
border-radius:5px;

}

#memoryPage{
    justify-content:flex-start;
    overflow-y:auto;
    padding-top:60px;
}

#memoryPage h1{
    margin-top:20px;
    margin-bottom:10px;
}

#memoryPage p{
    margin-bottom:40px;
}

html, body{
    width:100%;
    overflow-x:hidden;
    overscroll-behavior:none;
}

body{
    overflow-x:hidden;
}

.slot .photo{

width:90px;
height:125px;

background:white;
padding:8px 8px 20px;

border-radius:3px;

}

.slot .photo img{

width:100%;
height:90px;

object-fit:cover;

}

.slot .photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

html,body{
    max-width:100%;
    overflow-x:hidden;
}

.page{
    width:100vw;
    overflow-x:hidden;
}

.letters-grid{
    display:grid;
    grid-template-columns:repeat(3,80px);
    gap:20px;
    width:280px;
    margin:35px auto 0;
    justify-content:center;
}

.mini-letter{
    width:80px;
    height:80px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:40px;
}

.mini-letter.opened{
    opacity:.25;
    filter:grayscale(100%);
    transform:scale(.9);
    pointer-events:none;
    cursor:default;
}